OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
VISION_CONFIDENCE_THRESHOLD=0.60
MAX_IMAGE_SIZE_MB=10
DATABASE_URL=postgresql://postgres@localhost:5432/smart_fridge
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Optional recipe suggestion filters -- leave blank for no filtering.
# Only affects rows that have this metadata (see README section 11a).
RECIPE_VEGETARIAN_ONLY=
RECIPE_CUISINE_FILTER=
RECIPE_MAX_COOK_TIME_MINUTES=
